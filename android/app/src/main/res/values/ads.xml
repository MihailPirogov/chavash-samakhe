    <string name="ad_interstitial_id" translatable="false">demo-interstitial-yandex</string>
    <string name="ad_rewarded_id" translatable="false">demo-rewarded-yandex</string>
    <!-- Yandex demo units (always fill, no revenue) -->
    <string name="ad_banner_demo_id" translatable="false">demo-banner-yandex</string>
    <string name="ad_interstitial_demo_id" translatable="false">demo-interstitial-yandex</string>
    <string name="ad_rewarded_demo_id" translatable="false">demo-rewarded-yandex</string>
    <!-- Children: true = YandexAds.setAgeRestricted(true). General-audience word game (0+, not directed at children) -> false. -->
    <bool name="ads_age_restricted">false</bool>
